    },
    "./annotation-colours": {
      "types": "./src/annotation-colours.d.ts",
      "default": "./src/annotation-colours.js"
    },
    "./feature-colours": {
      "types": "./src/feature-colours.d.ts",
      "default": "./src/feature-colours.js"
