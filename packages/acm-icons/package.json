    },
    "./filled": {
      "types": "./src/filled.d.ts",
      "default": "./src/filled.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "npm run check && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
